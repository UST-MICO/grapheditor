{
  "name": "@ustutt/grapheditor-webcomponent",
  "version": "1.0.0",
  "description": "Webcomponent for displaying and editing graphs.",
  "author": "Fabian Bühler <fabian.buehler@iaas.uni-stuttgart.de>",
  "browser": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    ">=3.6": {
      "*": [
        "*"
      ]
    }
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "example": "example"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UST-MICO/grapheditor.git"
  },
  "keywords": [
    "webcomponent",
    "d3",
    "graph",
    "editor",
    "svg"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/UST-MICO/grapheditor/issues"
  },
  "homepage": "https://github.com/UST-MICO/grapheditor#readme",
  "scripts": {
    "start": "webpack serve --config webpack-dev.config.js",
    "lint": "eslint --ext=.ts",
    "lint-all": "eslint --ext=.ts .",
    "doc": "typedoc --exclude **/node_modules/**/*.* --exclude **/lib/**/* --exclude **/lib-esm/**/* --externalPattern **/node_modules/**/* --excludeExternals --entryPoints ./src/* --entryPointStrategy expand ./src --emit docs --out typedoc --json docs/typedoc.json",
    "doc-sphinx": "tsx --tsconfig '/home/fabian/.cache/pypoetry/virtualenvs/grapheditor-webcomponent-docs-FSBLijXX-py3.12/lib/python3.12/site-packages/sphinx_js/js/tsconfig.json' --import '/home/fabian/.cache/pypoetry/virtualenvs/grapheditor-webcomponent-docs-FSBLijXX-py3.12/lib/python3.12/site-packages/sphinx_js/js/registerImportHook.mjs' '/home/fabian/.cache/pypoetry/virtualenvs/grapheditor-webcomponent-docs-FSBLijXX-py3.12/lib/python3.12/site-packages/sphinx_js/js/main.ts' --entryPointStrategy expand --basePath '/home/fabian/git/private/grapheditor' --excludePrivate false --json ./docs '/home/fabian/git/private/grapheditor'",
    "clean": "rm -rf _bundles lib lib-esm",
    "package": "tsc",
    "package-es6": "tsc -m es6 --outDir lib-esm",
    "package-bundle": "webpack --mode production",
    "package-all": "npm run clean && npm run package && npm run package-es6 && npm run package-bundle"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/d3": "^7.4.3",
    "@webpack-cli/serve": "^3.0.1",
    "chai": "^4.0.0",
    "eslint": "^10.2.0",
    "html-webpack-plugin": "^5.6.6",
    "mocha": "^11.7.5",
    "simulant": "^0.2.2",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.7",
    "tslint": "^6.1.3",
    "tsx": "^4.9.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "webpack": "^5.106.1",
    "webpack-cli": "^6.0.0",
    "webpack-dev-middleware": "^8.0.3",
    "webpack-dev-server": "^5.2.5",
    "webpack-merge": "^6.0.1"
  }
}
